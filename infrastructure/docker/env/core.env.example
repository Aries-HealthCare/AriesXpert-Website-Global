# ==============================================================================
# ARIES HEALTHCARE ECO-SYSTEM — CORE INFRASTRUCTURE CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env before starting the core development stack:
# cp infrastructure/docker/env/core.env.example infrastructure/docker/env/core.env
#
# NOTE: DO NOT commit production secrets to Git.
# ==============================================================================

# --- Node & Express Runtime ---
NODE_ENV=development
PORT=5001
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# --- Primary Document Database (MongoDB) ---
# For local containerized dev or MongoDB Atlas dev cluster
MONGODB_URI=mongodb://localhost:27017/ariesxpert_dev

# --- Redis Cache & Queue Broker ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication & JWT Security ---
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_character_string
JWT_EXPIRES_IN=7d

# --- Payment Gateways (Sandbox Default for Dev) ---
CASHFREE_APP_ID=your_cashfree_sandbox_app_id
CASHFREE_APP_SECRET=your_cashfree_sandbox_secret_key
CASHFREE_MODE=SANDBOX

RAZORPAY_KEY_ID=rzp_test_dummykeyid
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# --- Communications & Messaging ---
# Meta WhatsApp Cloud API credentials
WHATSAPP_TOKEN=your_meta_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id

# Email (SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@ariesxpert.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@ariesxpert.com

# --- Cloud Storage (AWS S3) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=ariesxpert-dev-uploads

# --- Telehealth Video (Agora / LiveKit) ---
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
