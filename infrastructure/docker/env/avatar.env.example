# ==============================================================================
# ARIES HEALTHCARE ECO-SYSTEM — AVATAR & RENDER ENGINE CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env before starting the GPU avatar rendering stack:
# cp infrastructure/docker/env/avatar.env.example infrastructure/docker/env/avatar.env
# ==============================================================================

# --- Service Identity & Security ---
SERVICE_API_KEY=your_internal_avatar_service_key
JWT_SECRET=your_avatar_jwt_secret_32_characters
JWT_ISSUER=aries-avatar-engine
JWT_AUDIENCE=aries-healthcare-platform
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ariesxpert.com

# --- Redis Broker & Celery Queues ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object Storage (MinIO or AWS S3) ---
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=aries-avatar-assets

# --- HeyGem Render Engine ---
RENDER_ENGINE=heygem
ENGINE_VERSION=1.0.0
ENABLE_MIXED_PRECISION=true
ENABLE_FACE_ENHANCE=true
HEYGEM_API_URL=http://heygem-inference:8383
HEYGEM_DATA_DIR=/code/data
HEYGEM_SUPER_RESOLUTION=true
CUDA_VISIBLE_DEVICES=0
