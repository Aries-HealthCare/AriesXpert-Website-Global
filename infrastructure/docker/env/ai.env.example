# ==============================================================================
# ARIES HEALTHCARE ECO-SYSTEM — AI & OMNIROUTE CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env before starting the AI routing stack:
# cp infrastructure/docker/env/ai.env.example infrastructure/docker/env/ai.env
# ==============================================================================

# --- OmniRoute Gateway Ports ---
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
API_HOST=0.0.0.0

# --- Redis Rate Limiting & Routing Cache ---
REDIS_URL=redis://redis:6379

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Primary Cloud LLM Providers ---
# OpenRouter (Aggregated provider for 160+ models)
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# OpenAI / Anthropic (Optional direct access)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Local LLM & Ollama ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- OmniRoute Admin & Security ---
ADMIN_PASSWORD=change_this_omniroute_admin_password
SESSION_SECRET=change_this_session_secret_32_characters
