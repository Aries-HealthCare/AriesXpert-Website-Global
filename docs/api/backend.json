        "title",
        "description",
        "location",
        "role",
        "country"
      ]
    },
    "FAQ": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FAQ",
      "type": "object",
      "description": "Represents a frequently asked question.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the FAQ."
        },
        "question": {
          "type": "string",
          "description": "The question."
        },
        "answer": {
          "type": "string",
          "description": "The answer to the question."
        },
        "country": {
          "type": "string",
          "description": "The country this FAQ is relevant to (e.g., 'India', 'Global')."
        }
      },
      "required": [
        "id",
        "question",
        "answer",
        "country"
      ]
    },
    "AppointmentSlot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AppointmentSlot",
      "type": "object",
      "description": "Represents an available time slot for booking an appointment.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the appointment slot."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to Location. (Relationship: Location 1:N AppointmentSlot)"
        },
        "therapistId": {
          "type": "string",
          "description": "Reference to Therapist. (Relationship: Therapist 1:N AppointmentSlot)"
        },
        "startTime": {
          "type": "string",
          "description": "Start time of the appointment slot.",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "description": "End time of the appointment slot.",
          "format": "date-time"
        },
        "available": {
          "type": "boolean",
          "description": "Indicates whether the slot is available for booking."
        }
      },
      "required": [
        "id",
        "locationId",
        "therapistId",
        "startTime",
        "endTime",
        "available"
      ]
    },
    "Appointment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Appointment",
      "type": "object",
      "description": "Represents a booked appointment.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the appointment."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to Location. (Relationship: Location 1:N Appointment)"
        },
        "serviceId": {
          "type": "string",
          "description": "Reference to Service. (Relationship: Service 1:N Appointment)"
        },
        "therapistId": {
          "type": "string",
          "description": "Reference to Therapist. (Relationship: Therapist 1:N Appointment)"
        },
        "appointmentSlotId": {
          "type": "string",
          "description": "Reference to AppointmentSlot. (Relationship: AppointmentSlot 1:N Appointment)"
        },
        "patientName": {
          "type": "string",
          "description": "Name of the patient."
        },
        "patientEmail": {
          "type": "string",
          "description": "Email of the patient.",
          "format": "email"
        },
        "appointmentDate": {
          "type": "string",
          "description": "Date of the appointment.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "locationId",
        "serviceId",
        "therapistId",
        "appointmentSlotId",
        "patientName",
        "patientEmail",
        "appointmentDate"
      ]
    },
    "JobApplication": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "JobApplication",
      "type": "object",
      "description": "Represents a job application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the job application."
        },
        "jobOpeningId": {
          "type": "string",
          "description": "Reference to JobOpening. (Relationship: JobOpening 1:N JobApplication)"
        },
        "applicantName": {
          "type": "string",
          "description": "Name of the applicant."
        },
        "applicantEmail": {
          "type": "string",
          "description": "Email of the applicant.",
          "format": "email"
        },
        "resumeUrl": {
          "type": "string",
          "description": "URL of the uploaded resume."
        },
        "coverLetter": {
          "type": "string",
          "description": "Cover letter submitted by the applicant."
        }
      },
      "required": [
        "id",
        "jobOpeningId",
        "applicantName",
        "applicantEmail",
        "resumeUrl",
        "coverLetter"
      ]
    },
    "ContactFormSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ContactFormSubmission",
      "type": "object",
      "description": "Represents a submission from the contact form.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the contact form submission."
        },
        "name": {
          "type": "string",
          "description": "Name of the person submitting the form."
        },
        "email": {
          "type": "string",
          "description": "Email of the person submitting the form.",
          "format": "email"
        },
        "message": {
          "type": "string",
          "description": "The message submitted through the contact form."
        },
        "submissionDate": {
          "type": "string",
          "description": "Date and time when the form was submitted.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "message",
        "submissionDate"
      ]
    },
    "AiPrecisionRecovery": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AiPrecisionRecovery",
      "type": "object",
      "description": "Represents data and insights for the AI Precision Recovery feature.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the AI precision recovery data."
        },
        "stage": {
          "type": "string",
          "description": "The recovery stage (Assess, Plan, Track, Advance)."
        },
        "title": {
          "type": "string",
          "description": "Title or heading for the specific insight."
        },
        "description": {
          "type": "string",
          "description": "Detailed description or guidance for the current stage."
        },
        "iconUrl": {
          "type": "string",
          "description": "URL for an icon representing the stage or insight."
        },
        "data": {
          "type": "string",
          "description": "Additional data or metrics related to the insight. Could be JSON serialized data."
        }
      },
      "required": [
        "id",
        "stage",
        "title",
        "description",
        "iconUrl",
        "data"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/services/{serviceId}",
        "definition": {
          "entityName": "Service",
          "schema": {
            "$ref": "#/backend/entities/Service"
          },
          "description": "Stores information about services offered by Aries PhysioCare.",
          "params": [
            {
              "name": "serviceId",
              "description": "Unique identifier for the service."
            }
          ]
        }
      },
      {
        "path": "/therapists/{therapistId}",
        "definition": {
          "entityName": "Therapist",
          "schema": {
            "$ref": "#/backend/entities/Therapist"
          },
          "description": "Stores information about therapists.",
          "params": [
            {
              "name": "therapistId",
              "description": "Unique identifier for the therapist."
            }
          ]
        }
      },
      {
        "path": "/locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": {
            "$ref": "#/backend/entities/Location"
          },
          "description": "Stores information about the physical locations.",
          "params": [
            {
              "name": "locationId",
              "description": "Unique identifier for the location."
            }
          ]
        }
      },
      {
        "path": "/blogs/{blogId}",
        "definition": {
          "entityName": "Blog",
          "schema": {
            "$ref": "#/backend/entities/Blog"
          },
          "description": "Stores blog posts.",
          "params": [
            {
              "name": "blogId",
              "description": "Unique identifier for the blog post."
            }
          ]
        }
      },
      {
        "path": "/jobOpenings/{jobOpeningId}",
        "definition": {
          "entityName": "JobOpening",
          "schema": {
            "$ref": "#/backend/entities/JobOpening"
          },
          "description": "Stores job openings.",
          "params": [
            {
              "name": "jobOpeningId",
              "description": "Unique identifier for the job opening."
            }
          ]
        }
      },
      {
        "path": "/faqs/{faqId}",
        "definition": {
          "entityName": "FAQ",
          "schema": {
