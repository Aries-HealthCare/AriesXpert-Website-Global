
{
  "entities": {
    "Service": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service",
      "type": "object",
      "description": "Represents a service offered by Aries PhysioCare.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the service."
        },
        "name": {
          "type": "string",
          "description": "Name of the service."
        },
        "description": {
          "type": "string",
          "description": "Description of the service."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the image representing the service."
        },
        "country": {
          "type": "string",
          "description": "The country where the service is offered (e.g., 'India', 'Global')."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "imageUrl",
        "country"
      ]
    },
    "Therapist": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Therapist",
      "type": "object",
      "description": "Represents a therapist at Aries PhysioCare.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the therapist."
        },
        "qualification": {
          "type": "string",
          "description": "Qualification of the therapist."
        },
        "experience": {
          "type": "string",
          "description": "Experience of the therapist."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the therapist's image."
        },
        "imageHint": {
            "type": "string",
            "description": "A hint for AI image generation."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to Location. (Relationship: Location 1:N Therapist)"
        },
        "specializations": {
          "type": "array",
          "description": "List of specializations the therapist has",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "qualification",
        "experience",
        "imageUrl",
        "imageHint",
        "locationId",
        "specializations"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents a physical location of Aries PhysioCare.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the location."
        },
        "name": {
          "type": "string",
          "description": "Name of the location."
        },
        "address": {
          "type": "string",
          "description": "Address of the location."
        },
        "city": {
          "type": "string",
          "description": "City of the location."
        },
        "country": {
          "type": "string",
          "description": "Country of the location."
        },
        "googleMapsUrl": {
          "type": "string",
          "description": "URL of the Google Maps embed for the location."
        },
        "timings": {
          "type": "string",
          "description": "Operational timings of the location."
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "city",
        "country",
        "googleMapsUrl",
        "timings"
      ]
    },
    "Blog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Blog",
      "type": "object",
      "description": "Represents a blog post.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the blog post."
        },
        "title": {
          "type": "string",
          "description": "Title of the blog post."
        },
        "content": {
          "type": "string",
          "description": "Content of the blog post."
        },
        "author": {
          "type": "string",
          "description": "Author of the blog post."
        },
        "publishDate": {
          "type": "string",
          "description": "Date when the blog post was published.",
          "format": "date-time"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL to the image representing the blog."
        },
        "country": {
          "type": "string",
          "description": "The country this blog is relevant to (e.g., 'India', 'Global')."
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "author",
        "publishDate",
        "imageUrl",
        "country"
      ]
    },
    "JobOpening": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "JobOpening",
      "type": "object",
      "description": "Represents a job opening at Aries PhysioCare.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the job opening."
        },
        "title": {
          "type": "string",
          "description": "Title of the job opening."
        },
        "description": {
          "type": "string",
          "description": "Description of the job opening."
        },
        "location": {
          "type": "string",
          "description": "Location of the job (e.g., city, country)."
        },
        "role": {
          "type": "string",
          "description": "Role of the job (e.g., Physiotherapist, Nurse)."
        },
        "country": {
          "type": "string",
          "description": "The country for this job opening (e.g., 'India', 'Global')."
        }
      },
      "required": [
